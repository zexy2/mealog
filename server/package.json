{
  "name": "@mealog/server",
  "version": "0.1.0",
  "private": true,
  "description": "Mealog backend. NestJS at the edge; domain and pipeline stay framework-agnostic.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "supertest": "^7.1.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
